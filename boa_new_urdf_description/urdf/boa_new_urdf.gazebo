<?xml version="1.0" ?>
<robot name="boa_new_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo>
  <plugin filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find boa_new_urdf_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>
<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="right_caster_1">
  <material>${body_color}</material>
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
  <maxContacts>1</maxContacts>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="left_caster_1">
  <material>${body_color}</material>
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
  <maxContacts>1</maxContacts>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="drive_motor_1">
  <material>${body_color}</material>
  <mu1>1.5</mu1>
  <mu2>0.1</mu2>
  <kp>100000.0</kp>
  <kd>10.0</kd>
  <minDepth>0.001</minDepth>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="direction_motor_1">
  <material>${body_color}</material>
  <mu1>0.1</mu1>
  <mu2>0.1</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lift_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_fork_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_left_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="lidar_left_sensor" type="gpu_lidar">
    <topic>lidar_left_1/scan</topic>
    <gz_frame_id>lidar_left_1</gz_frame_id>
    <update_rate>15</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <!-- 270° FOV, 0.5° resolution (SICK S300 style) -->
          <samples>540</samples>
          <resolution>1</resolution>
          <min_angle>-2.35619449</min_angle>
          <max_angle>2.35619449</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0.0</min_angle>
          <max_angle>0.0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.1</min>
        <max>30.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.005</stddev>
      </noise>
    </lidar>
    <always_on>true</always_on>
    <enabled>true</enabled>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="lidar_right_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="lidar_right_sensor" type="gpu_lidar">
    <topic>lidar_right_1/scan</topic>
    <gz_frame_id>lidar_right_1</gz_frame_id>
    <update_rate>15</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <!-- 270° FOV, 0.5° resolution (SICK S300 style) -->
          <samples>540</samples>
          <resolution>1</resolution>
          <min_angle>-2.35619449</min_angle>
          <max_angle>2.35619449</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0.0</min_angle>
          <max_angle>0.0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.1</min>
        <max>30.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.005</stddev>
      </noise>
    </lidar>
    <always_on>true</always_on>
    <enabled>true</enabled>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="lidar_top">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="lidar_top_sensor" type="gpu_lidar">
    <topic>lidar_top/scan</topic>
    <gz_frame_id>lidar_top</gz_frame_id>
    <update_rate>10</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <!-- Aurora SLAMTEC: 0.33° resolution ≈ 1080 samples/rev, 40m range -->
          <samples>1080</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159265</min_angle>
          <max_angle>3.14159265</max_angle>
        </horizontal>
        <vertical>
          <!-- 16 channel, ±15° vertical FOV (VLP-16 style) -->
          <samples>16</samples>
          <resolution>1</resolution>
          <min_angle>-0.26179938</min_angle>
          <max_angle>0.26179938</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.3</min>
        <max>40.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
    <always_on>true</always_on>
    <enabled>true</enabled>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <topic>imu/data</topic>
    <gz_frame_id>imu_link</gz_frame_id>
    <update_rate>100</update_rate>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
      </linear_acceleration>
    </imu>
    <always_on>true</always_on>
    <enabled>true</enabled>
  </sensor>
</gazebo>

<gazebo reference="case_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

</robot>
