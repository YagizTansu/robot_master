<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
    <world name="default">

        <gravity>0 0 -9.8</gravity>
        <physics default="0" name="default_physics" type="ode">
            <max_step_size>0.005</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>

        <plugin name='ignition::gazebo::systems::Physics'
            filename='libignition-gazebo-physics-system.so' />
        <plugin name='ignition::gazebo::systems::UserCommands'
            filename='libignition-gazebo-user-commands-system.so' />
        <plugin name='ignition::gazebo::systems::SceneBroadcaster'
            filename='libignition-gazebo-scene-broadcaster-system.so' />
        <plugin name='ignition::gazebo::systems::Imu' filename='ignition-gazebo-imu-system' />
        <plugin name='ignition::gazebo::systems::Sensors' filename='ignition-gazebo-sensors-system'>
            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- ======== SHELF-F CORRIDOR (x = +4, 5 m pitch, 9 units) ======== -->
        <!-- x=+4: 13 m gap from W3(x=-9), 6 m gap from E1(x=+10) — no overlap -->

        <model name="aws_robomaker_warehouse_ShelfF_01_002">
            <include><uri>model://aws_robomaker_warehouse_ShelfF_01</uri></include>
            <pose frame="">4.0 -15.0 0 0 0 0</pose>
        </model>
        <model name="aws_robomaker_warehouse_ShelfF_01_003">
            <include><uri>model://aws_robomaker_warehouse_ShelfF_01</uri></include>
            <pose frame="">4.0 -10.0 0 0 0 0</pose>
        </model>
        <model name="aws_robomaker_warehouse_ShelfF_01_006">
            <include><uri>model://aws_robomaker_warehouse_ShelfF_01</uri></include>
            <pose frame="">4.0 5.0 0 0 0 0</pose>
        </model>

        <!-- ==================== WAREHOUSE FLOOR (single seamless 54x54 plane, eliminates tile gaps) ==================== -->
        <model name="warehouse_floor_plane">
            <static>true</static>
            <pose>0 0 -0.1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>54 54 0.2</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>54 54 0.2</size></box></geometry>
                    <material>
                        <ambient>0.58 0.58 0.58 1</ambient>
                        <diffuse>0.62 0.62 0.62 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>
            </link>
        </model>

