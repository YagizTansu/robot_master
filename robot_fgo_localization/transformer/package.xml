<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fgo_transformer</name>
  <version>0.1.0</version>
  <description>
    Transformer-based trust-weight predictor for the FGO localization stack.
    Provides:
      feature_extractor_node — records per-timestep sensor features + ground truth
                               error labels to CSV for offline Transformer training.
  </description>

  <maintainer email="yagiz@robot.local">Yagiz Tansu</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 runtime -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <!-- Linting -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
