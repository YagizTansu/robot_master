# ─────────────────────────────────────────────────────────────────────────────
# docker/.env — environment variables for docker-compose
#
# Copy this file as-is; edit paths only if your workspace is elsewhere.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to the ROS2 workspace on the host
WORKSPACE_PATH=/home/yagiz/ros2_ws

# Benchmark CSV output directory (created automatically if missing)
BENCHMARK_RESULTS_PATH=/home/yagiz/ros2_ws/benchmark_results

# X11 display (usually :0 or :1 on a desktop machine)
DISPLAY=:0
