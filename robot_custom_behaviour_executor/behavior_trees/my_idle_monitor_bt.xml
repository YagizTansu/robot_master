<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <Sequence name="MonitorSequence">

            <!-- ================================================================
                 LAYER 1: SAFETY — Highest priority. Any FAILURE here halts all
                 downstream nodes immediately (Sequence short-circuits).
                 EmergencyStop uses fail-safe: no message = FAILURE.
                 ================================================================ -->
            <EmergencyStop name="CheckEmergency"
                emergency_topic="/emergency_stop"
                button_pressed_value="true" />

            <!-- ================================================================
                 LAYER 2: HARDWARE HEALTH
                 Checks /diagnostics_agg for ERROR/STALE component status.
                 Fail-safe: no diagnostics message → FAILURE.
                 On hardware fault the Fallback also FAILs, propagating up to
                 halt the MonitorSequence (robot stops until fault is cleared).
                 ================================================================ -->
            <Fallback name="HardwareHealthManagement">
                <HardwareDiagnosticsCheck name="HWDiagCheck"
                    diagnostics_topic="/diagnostics_agg"
                    timeout_sec="3.0"
                    fail_on_level="2" />
                <!-- Hardware fault cannot be self-recovered — propagate FAILURE -->
                <AlwaysFailure name="HardwareFaultHalt" />
            </Fallback>

            <!-- ================================================================
                 LAYER 2.5: SENSOR HEALTH
                 Checks that critical sensor topics are publishing actively.
                 Fail-safe: silent sensor (topic not alive) → FAILURE.
                 A dead LiDAR or IMU makes navigation unsafe — halt.
                 ================================================================ -->
            <Fallback name="SensorHealthManagement">
                <Sequence name="SensorAliveChecks">
                    <TopicAliveCheck name="LidarAlive"
                        topic="/scan"
                        timeout_sec="2.0" />
                    <TopicAliveCheck name="OdomAlive"
                        topic="/odometry"
                        timeout_sec="2.0" />
                    <TopicAliveCheck name="ImuAlive"
                        topic="/imu/data"
                        timeout_sec="2.0" />
                </Sequence>
                <!-- Sensor failure is unrecoverable here — propagate FAILURE -->
                <AlwaysFailure name="SensorFaultHalt" />
            </Fallback>

            <!-- ================================================================
                 LAYER 3: LOCALIZATION QUALITY
                 Checks AMCL covariance on /amcl_pose.
                 Fail-safe: no pose message → FAILURE.
                 On poor localization the Fallback FAILs, halting the sequence
                 (navigation is unsafe without reliable pose).
                 ================================================================ -->
            <Fallback name="LocalizationManagement">
                <LocalizationQualityCheck name="LocQualityCheck"
                    amcl_topic="/amcl_pose"
                    max_covariance="0.5"
                    timeout_sec="2.0" />
                <!-- Poor localization cannot be self-recovered here — halt -->
                <AlwaysFailure name="LocalizationFaultHalt" />
            </Fallback>

            <!-- ================================================================
                 LAYER 3.5: NAVIGATION STACK HEALTH
                 Verifies that the Nav2 action server is alive before any
                 navigation attempt. A crashed planner would block indefinitely
                 without this guard.
                 ================================================================ -->
            <Fallback name="NavigationStackHealth">
                <ActionServerAliveCheck name="NavServerCheck"
                    action_name="/navigate_to_pose"
                    timeout_sec="3.0" />
                <!-- Nav stack down — alert and halt until recovered -->
                <AlwaysFailure name="NavStackHalt" />
            </Fallback>

            <!-- ================================================================
                 LAYER 4: BATTERY MANAGEMENT — Three levels
                   > 30%  : Normal operation   → SUCCESS, nothing to do
                   20-30% : Low warning        → Navigate to charger, full charge
                   < 20%  : Critical           → Navigate to charger immediately
                 The nested Fallback cascades: each BatteryCheck only SUCCEEDs
                 when battery is ABOVE its threshold, selecting the right branch.
                 ================================================================ -->
            <Fallback name="BatteryManagement">

                <!-- NORMAL: battery above 30% — no charging needed -->
                <BatteryCheck name="CheckBatteryNormal"
                    battery_topic="/battery_status"
                    min_battery_percentage="30.0" />

                <!-- LOW WARNING: battery 20–30% — finish soon and go charge -->
                <Sequence name="LowBatteryWarning">
                    <!-- This check SUCCEEDs only if battery is still above 20%.
                         Combined with the outer FAILURE (< 30%), this branch
                         executes precisely in the 20–30% window. -->
                    <BatteryCheck name="CheckBatteryWarning"
                        battery_topic="/battery_status"
                        min_battery_percentage="20.0" />
                    <GetChargeStationPose name="GetChargeStationWarning"
                        use_tf="false"
                        charge_station_x="0.8"
                        charge_station_y="-8.0"
                        charge_station_yaw="1.0"
                        frame_id="map"
                        charge_station_pose="{charge_pose}" />
                    <NavigateToChargeStation name="NavigateToChargeWarning"
                        charge_station_pose="{charge_pose}"
                        server_timeout="10.0"
                        action_timeout="300.0" />
                    <RetryUntilSuccessful name="ChargingLoopWarning" num_attempts="3600">
                        <BatteryCheck name="CheckBatteryFullWarning"
                            battery_topic="/battery_status"
                            min_battery_percentage="80.0" />
                    </RetryUntilSuccessful>
                </Sequence>

                <!-- CRITICAL: battery below 20% — both above checks failed, go now -->
                <Sequence name="CriticalBattery">
                    <GetChargeStationPose name="GetChargeStationCritical"
                        use_tf="false"
                        charge_station_x="0.8"
                        charge_station_y="-8.0"
                        charge_station_yaw="1.0"
                        frame_id="map"
                        charge_station_pose="{charge_pose}" />
                    <NavigateToChargeStation name="NavigateToChargeCritical"
                        charge_station_pose="{charge_pose}"
                        server_timeout="10.0"
                        action_timeout="300.0" />
                    <RetryUntilSuccessful name="ChargingLoopCritical" num_attempts="7200">
                        <BatteryCheck name="CheckBatteryFullCritical"
                            battery_topic="/battery_status"
                            min_battery_percentage="80.0" />
                    </RetryUntilSuccessful>
                </Sequence>

            </Fallback>

            <!-- ================================================================
                 LAYER 4.5: THERMAL MANAGEMENT
                 Monitors motor driver and compute board temperatures via
                 /diagnostics_agg. Overheating causes irreversible hardware
                 damage — robot must stop immediately.
                 ================================================================ -->
            <Fallback name="ThermalManagement">
                <ThermalCheck name="MotorTempCheck"
                    diagnostics_topic="/diagnostics_agg"
                    component_name="motor_driver"
                    max_temp_celsius="70.0" />
                <!-- Overheating — propagate FAILURE to halt all motion -->
                <AlwaysFailure name="ThermalHalt" />
            </Fallback>

            <!-- ================================================================
                 LAYER 5: FLEET MANAGER CONNECTIVITY (non-critical)
                 If the fleet manager is offline, robot continues autonomously.
                 AlwaysSuccess as fallback: fleet loss degrades gracefully.
                 ================================================================ -->
            <Fallback name="FleetConnectivity">
                <FleetManagerCheck name="FleetCheck"
                    heartbeat_topic="/fleet_manager/heartbeat"
                    timeout_sec="5.0" />
                <!-- Fleet offline is a warning — robot keeps operating -->
                <AlwaysSuccess name="FleetOfflineWarning" />
            </Fallback>

            <!-- ================================================================
                 LAYER 6: PROXIMITY SAFETY (non-critical)
                 Checks for obstacles within the safety zone from /scan.
                 In human-shared environments the robot slows/stops when an
                 obstacle enters the inner safety radius.
                 AlwaysSuccess fallback: handled gracefully, does not halt.
                 ================================================================ -->
            <Fallback name="ProximitySafety">
                <ProximityCheck name="SafetyZoneCheck"
                    laser_topic="/scan"
                    safety_radius_m="0.4"
                    warning_radius_m="0.8" />
                <!-- Obstacle in safety zone — issue warning, keep operating -->
                <AlwaysSuccess name="ProximityWarningIssued" />
            </Fallback>

            <!-- ================================================================
                 LAYER 7: SYSTEM RESOURCES
                 Guards against CPU/RAM exhaustion and full-disk conditions
                 that could crash ROS2 nodes silently during long missions.
                 Non-critical: warns but does not halt operation.
                 ================================================================ -->
            <Fallback name="SystemResources">
                <SystemResourceCheck name="ResourceCheck"
                    max_cpu_percent="90.0"
                    max_memory_percent="85.0"
                    min_disk_free_mb="500" />
                <!-- Resource pressure — warn operator, continue operating -->
                <AlwaysSuccess name="ResourceWarningIssued" />
            </Fallback>

            <!-- ================================================================
                 LAYER 8: TIME SYNCHRONISATION
                 ROS2 TF transforms use wall-clock timestamps; NTP drift above
                 100 ms causes transform extrapolation errors in Nav2.
                 Non-critical: warns but does not halt (may self-recover).
                 ================================================================ -->
            <Fallback name="TimeSync">
                <TimeSyncCheck name="CheckNTP"
                    max_offset_ms="100.0" />
                <!-- Clock drift warning — robot keeps operating -->
                <AlwaysSuccess name="TimeSyncWarning" />
            </Fallback>

            <!-- Monitoring cycle complete -->
            <AlwaysSuccess name="MonitoringComplete" />

        </Sequence>
    </BehaviorTree>
</root>
